{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "buildCommand": "node scripts/prepare-vercel.js",

  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "regions": ["sin1"]
    }
  },

  "routes": [
    {
      "src": "^/sitemap.xml$",
      "dest": "/sitemap.xml"
    },
    {
      "src": "^/robots.txt$",
      "dest": "/robots.txt"
    },

    {
      "src": "^/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "^/health$",
      "dest": "/api/index.js"
    }
  ]
}