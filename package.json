{
  "name": "course-platform",
  "version": "1.0.0",
  "description": "Driving school platform with landing page, online exam, admin dashboard, and Google Sheets Apps Script integration.",
  "main": "server/src/index.js",
  "scripts": {
    "start": "node server/src/index.js",
    "dev": "node --watch server/src/index.js",
    "vercel-build": "node scripts/prepare-vercel.js",
    "test": "jest",
    "test:client": "jest --selectProjects client",
    "test:server": "jest --selectProjects server",
    "test:e2e": "playwright test",
    "typecheck:client": "tsc --noEmit -p client/jsconfig.json",
    "build:sw-manifest": "node scripts/build-sw-manifest.js",
    "prestart": "npm run build:sw-manifest"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "typescript": "^5.8.3",
    "@babel/preset-env": "^7.26.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "chart.js": "^4.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2"
  }
}
